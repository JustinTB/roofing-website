---
import "../styles/global.css";
import { site } from "../content/site";
const { title = site.company, description = "Roof repair and replacement." } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header>
      <div class="wrap">
        <div class="logo-section">
          <img src="/logo.png" alt="Lukasek Roofing Logo" class="logo" />
          <div>
            <strong class="company-name">{site.company}</strong>
            <div class="location">{site.location}</div>
          </div>
        </div>
        <nav>
          <a href="/">Home</a>
          <a href="/services/">Services</a>
          <a href="/gallery/">Gallery</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer>
      <div class="wrap">
        <div><strong>Contact</strong></div>
        <div style="margin-top:6px;">
          Phone: <a href={"tel:" + site.phoneLink}>{site.phoneDisplay}</a><br/>
          Email: <a href={"mailto:" + site.email}>{site.email}</a>
        </div>
        <p style="margin-top:10px;">
          <small>{site.tagline}</small>
        </p>
      </div>
    </footer>
  </body>
</html>
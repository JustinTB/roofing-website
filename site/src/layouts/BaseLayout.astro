---
import "../styles/global.css";
import { site } from "../content/site";
import { getImage } from "astro:assets";
import logo from "../../../public/logo.png";
const { title = site.company, description = "Roof repair and replacement." } = Astro.props;

// Get the base URL for dynamic paths
const baseUrl = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header>
      <div class="wrap">
        <div class="logo-section">
          <img src={logo.src} alt="Lukasek Roofing Logo" class="logo" />
          <div>
            <strong class="company-name">{site.company}</strong>
            <div class="location">{site.location}</div>
          </div>
        </div>
        <nav>
          <a href={baseUrl}>Home</a>
          <a href={baseUrl + "services"}>Services</a>
          <a href={baseUrl + "gallery"}>Gallery</a>
          <a href={baseUrl + "about"}>About</a>
          <a href={baseUrl + "contact"}>Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer>
      <div class="wrap">
        <div><strong>Contact</strong></div>
        <div style="margin-top:6px;">
          Phone: <a href={"tel:" + site.phoneLink}>{site.phoneDisplay}</a><br/>
          Email: <a href={"mailto:" + site.email}>{site.email}</a>
        </div>
        <p style="margin-top:10px;">
          <small>{site.tagline}</small>
        </p>
      </div>
    </footer>
  </body>
</html>